# Where the Nimbus server is. No trailing slash.
NIMBUS_URL=https://nimbus-f6f5.onrender.com

# The key that server was started with. /v1/models is open; asking is not.
NIMBUS_API_KEY=

# Optional. Seconds to wait for one answer. A free-tier server waking from
# sleep can take a minute before it starts thinking.
NIMBUS_TIMEOUT=600
